{
  "name": "scribble",
  "productName": "Scribble",
  "private": true,
  "version": "0.1.0",
  "description": "A paper-feel writing desk for novels and stories.",
  "author": "Zhuri Solan",
  "license": "MIT",
  "main": "dist-electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:desktop": "node scripts/desktop-dev.mjs",
    "build": "npm run typecheck && vite build",
    "build:desktop": "npm run typecheck && vite build --mode desktop && node scripts/build-electron.mjs",
    "dist:desktop": "npm run build:desktop && electron-builder --publish never",
    "typecheck": "tsc --noEmit && tsc --noEmit -p electron",
    "preview": "vite preview",
    "icons": "pwa-assets-generator"
  },
  "devDependencies": {
    "@fontsource/courier-prime": "^5.1.0",
    "@fontsource/crimson-pro": "^5.1.0",
    "@fontsource/eb-garamond": "^5.1.0",
    "@fontsource/literata": "^5.1.0",
    "@tiptap/core": "^2.11.0",
    "@tiptap/extension-placeholder": "^2.11.0",
    "@tiptap/pm": "^2.11.0",
    "@tiptap/react": "^2.11.0",
    "@tiptap/starter-kit": "^2.11.0",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/turndown": "^5.0.5",
    "@vite-pwa/assets-generator": "^1.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "dexie": "^4.0.10",
    "dexie-react-hooks": "^1.1.7",
    "electron": "^38.8.6",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "lucide-react": "^0.460.0",
    "mammoth": "^1.8.0",
    "marked": "^15.0.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "turndown": "^7.2.0",
    "typescript": "~5.6.3",
    "vite": "^6.0.0",
    "vite-plugin-pwa": "^1.0.0"
  }
}
