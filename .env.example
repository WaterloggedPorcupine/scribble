# Copy this file to .env.local and fill in the values from Google Cloud Console.
# See README.md → "Connect Google Drive" for step-by-step instructions.
# The app works without these; Google Drive import and sync stay switched off.

# OAuth 2.0 Client ID (type: Web application)
VITE_GOOGLE_CLIENT_ID=

# API key (used only by the Google file picker)
VITE_GOOGLE_API_KEY=

# Project number (Cloud Console → project settings), needed by the picker
VITE_GOOGLE_APP_ID=
